# ==========================================================================
# pnpm 纵深防御配置（供应链安全加固）
# 依据：ChainDrop npm 供应链投毒事件调查报告 §4.4 第三方补充操作要点
# ==========================================================================

# 新发布冷却期（单位：分钟）
# 4320 分钟 = 3 天。pnpm 不会安装距今不足 3 天的新发布版本，
# 避免第一时间安装刚被投毒的恶意版本（对应报告推荐的 npm min-release-age）。
minimumReleaseAge=4320

# 安装脚本门控
# 全局禁用所有依赖的 lifecycle scripts（preinstall/install/postinstall 等），
# 阻断 "preinstall → setup.mjs" 类载荷投递链。
# 注意：被 legitimately 需要构建脚本的依赖（如 sharp）须通过
# package.json 的 pnpm.onlyBuiltDependencies 白名单单独放行。
ignore-scripts=true
